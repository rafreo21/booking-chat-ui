# --- Easiest: Google Apps Script (no service account) ---
# Paste scripts/google-apps-script/booking-append.gs into the spreadsheet’s Apps Script,
# deploy as Web app (Anyone), then set:
GOOGLE_APPS_SCRIPT_URL=
# Optional; if set, add same value as Script property BOOKING_SECRET in Apps Script.
GOOGLE_APPS_SCRIPT_SECRET=

# --- Alternative: Google Sheets API + service account ---
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional override (defaults to the booking-chat-ui sheet in the repo):
# GOOGLE_SHEET_ID=
# GOOGLE_SHEET_RANGE=Sheet1!A:I

# Optional: require Authorization: Bearer … from the browser (set VITE_BOOKING_INGEST_SECRET too).
# BOOKING_INGEST_SECRET=
# VITE_BOOKING_INGEST_SECRET=

# Local dev without vercel dev: point at production API.
# VITE_SHEETS_APPEND_URL=https://your-project.vercel.app/api/sheets-append

# Optional: checkout URL for "Pay for whole meal" on `/reservation/:token` preview.
# VITE_MEAL_PAYMENT_URL=

# --- Local dev (one server; restaurant is not a separate port) ---
# npm run dev  →  http://localhost:5173/
# Guest home:  /
# Restaurant:  /restaurant/login  ·  /restaurant/dashboard
# npm run dev:guest / npm run dev:restaurant — same command as npm run dev (alias).
#
# Optional advanced: two Vite processes on different origins — set:
#   VITE_SPLIT_DEV_SHELLS=true
#   VITE_GUEST_APP_ORIGIN=http://localhost:5173
#   VITE_RESTAURANT_APP_ORIGIN=http://localhost:5174
# Then run two terminals (vite on each port). Leave unset for normal work.

# --- Restaurant dashboard (Google via Supabase Auth) ---
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# Use the same public origin you deploy on (OAuth redirect). Falls back to window.location.origin if unset.
# VITE_PUBLIC_APP_ORIGIN=https://your-domain.com
# In Supabase: Authentication → Providers → Google (client id + secret).
# Add redirect URL: https://your-domain.com/restaurant/auth/callback
# Local dev (single server): http://localhost:5173/restaurant/auth/callback
#
# Restaurant dashboard demo login (any valid-looking email → dashboard; bypasses magic links):
# Off by default in production builds. During npm run dev it is ON unless you set:
# VITE_RESTAURANT_EMAIL_LOGIN_BYPASS=false
# Preview/staging demo builds only — explicitly enable:
# VITE_RESTAURANT_EMAIL_LOGIN_BYPASS=true
#
# Guest booking confirm: if Supabase `reservations` insert fails, save locally instead — **on by default in npm run dev**.
# Production: opt in with VITE_BOOKING_FALLBACK_LOCAL_ON_ERROR=true . Disable fallback in dev: =false
